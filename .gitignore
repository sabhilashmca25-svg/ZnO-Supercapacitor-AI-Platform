# ═══════════════════════════════════════════════════════════════
#  ZnO Supercapacitor AI Platform — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.so

# ── Environment files (may contain secrets) ───────────────────────────────────
.env
.env.local
.env.production
.env.*.local
# Backend .env has real ALLOWED_ORIGINS / secrets — never commit it
backend/.env

# ── Backend runtime logs (generated, not source) ──────────────────────────────
backend/server_*.txt
*.log
logs/

# ════════════════════════════════════════════════════════════════
#  ML MODEL FILES
#
#  Commit strategy:
#   ALL models → committed via git (small) or Git LFS (RF)
#
#   Small models (< 2 MB each) → committed directly to git:
#     lightgbm_model.joblib (1.7 MB)
#     xgboost_model.joblib  (0.27 MB)
#     ann_model.keras       (0.18 MB)
#     gru_model.keras       (0.34 MB)
#     lstm_model.keras      (0.43 MB)
#
#   RF model (201 MB) → tracked via Git LFS
#     Requires:  git lfs install   (once per machine)
#     Then:      git clone <repo>  (LFS downloads automatically)
#     See .gitattributes for the LFS tracking rule.
# ════════════════════════════════════════════════════════════════

# RF backups — gitignored (LFS handles the real model file)
models/rf/*.backup

# Auxiliary model text dumps — NOT loaded by the backend at runtime
# (backend loads *.joblib and *.keras files only)
models/lightgbm/*.txt
models/xgboost/*.json

# Small model files are NOT listed here → they ARE committed:
#   models/lightgbm/lightgbm_model.joblib  (1.7 MB)
#   models/xgboost/xgboost_model.joblib    (0.3 MB)
#   models/ann/ann_model.keras             (0.2 MB)
#   models/lstm/lstm_model.keras           (0.4 MB)
#   models/gru/gru_model.keras             (0.3 MB)

# ── Model metadata + shared config — always committed ─────────────────────────
# (these are already not ignored — listed here for documentation)
# models/shared/scalers/scalers.json
# models/shared/feature_config.json
# models/shared/model_registry.json
# models/*/metadata.json

# ── Data ──────────────────────────────────────────────────────────────────────
# Raw source data — not needed at runtime
data/raw/

# Processed partition parquets — not needed at runtime
data/processed/train_set.parquet
data/processed/val_set.parquet
data/processed/test_scanrate.parquet
data/processed/test_material.parquet
data/processed/scalers.json

# master_long_format.parquet IS committed (1.8 MB).
# Required by: GET /api/v1/experimental/{material}/{sr}
#              POST /api/v1/validation/compare
# (Not listed here = not ignored = committed)

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.env.local
frontend/.env.production
frontend/tsconfig.node.tsbuildinfo
frontend/tsconfig.tsbuildinfo
frontend/vite.config.d.ts

# ── Tool / Editor workspaces (local-only, not portable) ───────────────────────
.serena/
frontend/.claude/

# ── Runtime lock / temp ───────────────────────────────────────────────────────
.launcher.lock

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Stale / duplicate files ────────────────────────────────────────────────────
# frontend/vite.config.ts is the authoritative config
frontend/vite.config.js
