# ═══════════════════════════════════════════════════════════════════
#  ZnO Supercapacitor AI Platform — Environment Variables Reference
#
#  BACKEND (.env in backend/):
#    Copy this section to backend/.env and fill in real values.
#    See backend/.env.production.example for production values.
#
#  FRONTEND (Vercel dashboard or frontend/.env.production):
#    Set VITE_API_URL to your deployed backend URL.
#    In development, leave VITE_API_URL empty (proxy handles routing).
# ═══════════════════════════════════════════════════════════════════

# ── Backend ──────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
API_PORT=8000
DOCS_ENABLED=true             # false hides /docs and /redoc in production

# Model loading
ENABLE_WARMUP=true            # Run silent inference at startup to warm TF graphs
WARMUP_MATERIAL=NM1
WARMUP_SCAN_RATE=30
PREDICTION_CACHE_SIZE=128     # LRU cache entries; 0 = disabled

# Which models to load at startup (JSON array format required)
# Development: all 6 models
# Production free tier (512 MB RAM): exclude rf
ENABLED_MODELS=["rf","lightgbm","gru","xgboost","ann","lstm"]

# CORS — your React frontend URL(s)
# Development: localhost ports
# Production: your Vercel deployment URL
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set in Vercel dashboard → Settings → Environment Variables
# Development: leave empty (Vite proxy forwards /api/* to localhost:8000)
# Production:  set to your Render backend URL
VITE_API_URL=https://your-backend.onrender.com
