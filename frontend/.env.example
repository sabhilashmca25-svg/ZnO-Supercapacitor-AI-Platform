# ─────────────────────────────────────────────────────────
#  ZnO Supercapacitor AI Platform — Frontend Env Variables
#
#  Copy this file to .env.production and fill in values.
# ─────────────────────────────────────────────────────────

# Backend API base URL.
# • Development:  leave empty — Vite proxy forwards /api/* to localhost:8000
# • Production:   set to your deployed backend (e.g. Render URL)
VITE_API_URL=https://your-backend.onrender.com
