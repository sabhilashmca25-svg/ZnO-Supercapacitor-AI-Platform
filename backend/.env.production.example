# ─────────────────────────────────────────────────────────────────
#  ZnO Supercapacitor AI Platform — Backend PRODUCTION Config
#
#  Copy this file to .env on your server (Render, VPS, etc.)
#  and fill in the real values.
#
#  List values MUST use JSON array format:
#    ENABLED_MODELS=["lightgbm","gru"]   ← correct
#    ENABLED_MODELS=lightgbm,gru         ← will NOT parse
# ─────────────────────────────────────────────────────────────────

APP_ENV=production
LOG_LEVEL=INFO
API_PORT=8000

# Show /docs and /redoc (set to false for locked-down deployments)
DOCS_ENABLED=true

# Run a warm-up inference per model at startup to pre-compile TF graphs
ENABLE_WARMUP=true
WARMUP_MATERIAL=NM1
WARMUP_SCAN_RATE=30

# LRU cache size for prediction results (0 = disabled)
PREDICTION_CACHE_SIZE=128

# Models to load (RF = 211 MB compressed; requires 2 GB+ RAM plan)
# Free-tier Render (512 MB): use lightgbm,gru,xgboost,ann,lstm
# Paid Render (2 GB+):       add "rf" to the list
ENABLED_MODELS=["lightgbm","gru","xgboost","ann","lstm"]

# CORS — your Vercel frontend URL(s)
# Format: JSON array of full URLs including protocol
ALLOWED_ORIGINS=["https://your-app.vercel.app"]
