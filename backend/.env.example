# ─────────────────────────────────────────────────────────────────
#  ZnO Supercapacitor AI Platform — Backend Environment Config
#
#  Copy this file to backend/.env and modify as needed.
#  All values below are the DEFAULTS — the backend works out of
#  the box without a .env file; only override what you need.
#
#  IMPORTANT — List values MUST use JSON array format:
#    ENABLED_MODELS=["rf","lightgbm","gru"]   ← correct
#    ENABLED_MODELS=rf,lightgbm,gru           ← will NOT parse
# ─────────────────────────────────────────────────────────────────

APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000

# Show interactive API docs at /docs and /redoc
DOCS_ENABLED=true

# Pre-compile TF graphs on startup (recommended)
ENABLE_WARMUP=true
WARMUP_MATERIAL=NM1
WARMUP_SCAN_RATE=30

# LRU prediction cache (0 = disabled)
PREDICTION_CACHE_SIZE=128

# Models to load — add "rf" only if you have the RF model file
# (rf_baseline.joblib, ~201 MB — must be placed in models/rf/ manually)
ENABLED_MODELS=["lightgbm","gru","xgboost","ann","lstm"]

# CORS — add your frontend URL if you run on a non-default port
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
