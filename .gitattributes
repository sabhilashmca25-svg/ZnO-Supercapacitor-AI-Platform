# Line endings
# Enforce LF line endings for all text files on all platforms.
* text=auto eol=lf
# Windows batch files must use CRLF
*.bat text eol=crlf

# Binary files -- diff disabled
# These are binary formats; git stores them as blobs (or LFS pointers).
*.joblib  binary
*.keras   binary
*.parquet binary
*.png     binary
*.jpg     binary
*.ico     binary
*.woff2   binary
*.xlsx    binary

# Git LFS -- large RF model stored via Large File Storage
# Requires: git lfs install  (once per machine, before cloning)
# GitHub automatically serves LFS files on clone.
models/rf/*.joblib filter=lfs diff=lfs merge=lfs -text
